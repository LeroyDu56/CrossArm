    PROC Log(string name)
        VAR iodev f;
        Open "HOME:" \File:="motionprobe.txt", f \Append;
        Write f, name+" "+NumToStr(ClkRead(clk\HighRes),3);
        Close f;
    ENDPROC
ENDMODULE
