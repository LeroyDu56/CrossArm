MODULE MotionProbe
    ! CrossArm - motion probe. In RobotStudio, PROC Probe times every run (ClkRead \HighRes) and
    ! writes 'name time' to HOME:/motionprobe.txt. PROC Path is what CrossArm converts. Real motion:
    ! RobotStudio only.
    CONST robtarget pCornerA:=[[1100,-200,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pCornerB:=[[1400,-200,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pCornerC:=[[1400,200,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pLineA:=[[1100,-300,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pLineB:=[[1100,300,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pJointA:=[[1100,-400,600],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pJointB:=[[1400,300,1000],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pSwingA:=[[1100,-500,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pSwingB:=[[1100,500,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pRiseA:=[[1250,0,500],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pRiseB:=[[1250,0,1100],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    VAR clock clk;

    PROC Path()
        MoveL pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v1000,fine,tool0;
        MoveL pCornerC,v1000,fine,tool0;
        MoveL pLineA,v1000,fine,tool0;
        MoveL pLineB,v1000,fine,tool0;
        MoveJ pJointA,v1000,fine,tool0;
        MoveJ pJointB,v1000,fine,tool0;
        MoveL pSwingA,v1000,fine,tool0;
        MoveL pSwingB,v1000,fine,tool0;
        MoveL pRiseA,v1000,fine,tool0;
        MoveL pRiseB,v1000,fine,tool0;
    ENDPROC

    PROC Probe()
        VAR iodev f;
        Open "HOME:" \File:="motionprobe.txt", f \Write;
        Close f;
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v100,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v100";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v200,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v200";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v300,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v300";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v500,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v500";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v800,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v800";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v1000,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v1000";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v1500,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v1500";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v2000,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v2000";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v3000,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint v3000";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,vmax,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "joint vmax";
        MoveJ pSwingA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pSwingB,v100,fine,tool0;
        WaitTime\InPos,0;
