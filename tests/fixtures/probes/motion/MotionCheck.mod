MODULE MotionCheck
    ! CrossArm - motion check. PROC CheckPath is converted by CrossArm with its measured settings; in
    ! RobotStudio, PROC Check runs the same moves timed and writes HOME:/motioncheck.txt. Real motion:
    ! RobotStudio only.
    CONST robtarget pCornerA:=[[1100,-200,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pCornerB:=[[1400,-200,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pCornerC:=[[1400,200,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pLineA:=[[1100,-300,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pLineB:=[[1100,300,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pJointA:=[[1100,-400,600],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pJointB:=[[1400,300,1000],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pSwingA:=[[1100,-500,800],[0,0.3826834,0.9238795,0],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pSwingB:=[[1100,500,800],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pRiseA:=[[1250,0,500],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget pRiseB:=[[1250,0,1100],[0,0.3826834,0.9238795,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    VAR clock clk;

    PROC CheckPath()
        MoveJ pJointA,v1000,fine,tool0;
        MoveJ pJointB,v400,fine,tool0;
        MoveJ pJointA,v1000,fine,tool0;
        MoveJ pJointB,v600,fine,tool0;
        MoveJ pSwingA,v1000,fine,tool0;
        MoveJ pSwingB,v400,fine,tool0;
        MoveJ pSwingA,v1000,fine,tool0;
        MoveJ pSwingB,v600,fine,tool0;
        MoveJ pRiseA,v1000,fine,tool0;
        MoveJ pRiseB,v400,fine,tool0;
        MoveJ pRiseA,v1000,fine,tool0;
        MoveJ pRiseB,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v300,z5,tool0;
        MoveL pCornerC,v300,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v300,z10,tool0;
        MoveL pCornerC,v300,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v300,z20,tool0;
        MoveL pCornerC,v300,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v300,z30,tool0;
        MoveL pCornerC,v300,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v600,z5,tool0;
        MoveL pCornerC,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v600,z10,tool0;
        MoveL pCornerC,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v600,z20,tool0;
        MoveL pCornerC,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveL pCornerB,v600,z30,tool0;
        MoveL pCornerC,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveJ pCornerB,v600,z10,tool0;
        MoveJ pCornerC,v600,fine,tool0;
        MoveJ pCornerA,v1000,fine,tool0;
        MoveJ pCornerB,v600,z20,tool0;
        MoveJ pCornerC,v600,fine,tool0;
    ENDPROC

    PROC Check()
        VAR iodev f;
        Open "HOME:" \File:="motioncheck.txt", f \Write;
        Close f;
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v400,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check joint v400";
        MoveJ pJointA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pJointB,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check joint v600";
        MoveJ pSwingA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pSwingB,v400,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check swing v400";
        MoveJ pSwingA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pSwingB,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check swing v600";
        MoveJ pRiseA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pRiseB,v400,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check rise v400";
        MoveJ pRiseA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pRiseB,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check rise v600";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v300,z5,tool0;
        MoveL pCornerC,v300,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v300 z5";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v300,z10,tool0;
        MoveL pCornerC,v300,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v300 z10";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v300,z20,tool0;
        MoveL pCornerC,v300,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v300 z20";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v300,z30,tool0;
        MoveL pCornerC,v300,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v300 z30";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v600,z5,tool0;
        MoveL pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v600 z5";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v600,z10,tool0;
        MoveL pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v600 z10";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v600,z20,tool0;
        MoveL pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v600 z20";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveL pCornerB,v600,z30,tool0;
        MoveL pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check corner v600 z30";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pCornerB,v600,z10,tool0;
        MoveJ pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check jcorner v600 z10";
        MoveJ pCornerA,v1000,fine,tool0;
        ClkReset clk;
        ClkStart clk;
        MoveJ pCornerB,v600,z20,tool0;
        MoveJ pCornerC,v600,fine,tool0;
        WaitTime\InPos,0;
        ClkStop clk;
        Log "check jcorner v600 z20";
    ENDPROC

    PROC Log(string name)
        VAR iodev f;
        Open "HOME:" \File:="motioncheck.txt", f \Append;
        Write f, name+" "+NumToStr(ClkRead(clk\HighRes),3);
        Close f;
    ENDPROC
ENDMODULE
