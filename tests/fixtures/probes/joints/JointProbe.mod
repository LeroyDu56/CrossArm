MODULE JointProbe
    ! CrossArm - probe of jointtargets read on the robot: see tools/make_joint_probe.py.
    CONST jointtarget jpTargetA:=[[10,-20,30,40,-50,60],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget jpTargetB:=[[-30,15,-10,-100,70,-150],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget jpHome:=[[0,0,0,0,-90,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    PERS tooldata jpTool:=[TRUE,[[0,0,150],[1,0,0,0]],[2,[0,0,50],[1,0,0,0],0,0,0]];
    VAR jointtarget jpNow;
    VAR jointtarget jpKeep;
    VAR bool jpBelow;
    VAR num jpA1:=0;
    VAR num jpA2:=0;
    VAR num jpA3:=0;
    VAR num jpA4:=0;
    VAR num jpA5:=0;
    VAR num jpA6:=0;
    VAR num jpB1:=0;
    VAR num jpB2:=0;
    VAR num jpB3:=0;
    VAR num jpB4:=0;
    VAR num jpB5:=0;
    VAR num jpB6:=0;
    VAR num jpBack1:=0;
    VAR num jpBack2:=0;
    VAR num jpBack3:=0;
    VAR num jpBack4:=0;
    VAR num jpBack5:=0;
    VAR num jpBack6:=0;
    VAR num jpHigh:=0;
    VAR num jpLow:=0;
    VAR num jpSum:=0;

    PROC JpProbe()
        jpA1:=0;
        jpA2:=0;
        jpA3:=0;
        jpA4:=0;
        jpA5:=0;
        jpA6:=0;
        jpB1:=0;
        jpB2:=0;
        jpB3:=0;
        jpB4:=0;
        jpB5:=0;
        jpB6:=0;
        jpBack1:=0;
        jpBack2:=0;
        jpBack3:=0;
        jpBack4:=0;
        jpBack5:=0;
        jpBack6:=0;
        jpHigh:=0;
        jpLow:=0;
        jpSum:=0;
        MoveAbsJ jpTargetA,v1000,fine,tool0;
        jpNow:=CJointT();
        jpA1:=jpNow.robax.rax_1;
        jpA2:=jpNow.robax.rax_2;
        jpA3:=jpNow.robax.rax_3;
        jpA4:=jpNow.robax.rax_4;
        jpA5:=jpNow.robax.rax_5;
        jpA6:=jpNow.robax.rax_6;
        jpKeep:=jpNow;
        IF jpNow.robax.rax_2>-30 THEN
            jpHigh:=1;
        ENDIF
        IF jpNow.robax.rax_3>25 jpHigh:=jpHigh+10;
        jpBelow:=jpNow.robax.rax_5<-40;
        IF jpBelow jpLow:=1;
        jpSum:=jpNow.robax.rax_4+jpNow.robax.rax_6;
        MoveAbsJ jpTargetB,v1000,fine,tool0;
        jpNow:=CJointT();
        jpB1:=jpNow.robax.rax_1;
        jpB2:=jpNow.robax.rax_2;
        jpB3:=jpNow.robax.rax_3;
        jpB4:=jpNow.robax.rax_4;
        jpB5:=jpNow.robax.rax_5;
        jpB6:=jpNow.robax.rax_6;
        MoveAbsJ jpHome,v1000,fine,jpTool;
        MoveAbsJ jpKeep,v1000,fine,jpTool;
        jpNow:=CJointT();
        jpBack1:=jpNow.robax.rax_1;
        jpBack2:=jpNow.robax.rax_2;
        jpBack3:=jpNow.robax.rax_3;
        jpBack4:=jpNow.robax.rax_4;
        jpBack5:=jpNow.robax.rax_5;
        jpBack6:=jpNow.robax.rax_6;
    ENDPROC

    PROC Probe()
        VAR iodev file;
        VAR num v;
        JpProbe;
        Open "HOME:" \File:="jointprobe.txt", file \Write;
        v:=jpA1;
        Write file, "jpA1 " \Num:=v;
        v:=jpA2;
        Write file, "jpA2 " \Num:=v;
        v:=jpA3;
        Write file, "jpA3 " \Num:=v;
        v:=jpA4;
        Write file, "jpA4 " \Num:=v;
        v:=jpA5;
        Write file, "jpA5 " \Num:=v;
        v:=jpA6;
        Write file, "jpA6 " \Num:=v;
        v:=jpB1;
        Write file, "jpB1 " \Num:=v;
        v:=jpB2;
        Write file, "jpB2 " \Num:=v;
        v:=jpB3;
        Write file, "jpB3 " \Num:=v;
        v:=jpB4;
        Write file, "jpB4 " \Num:=v;
        v:=jpB5;
        Write file, "jpB5 " \Num:=v;
        v:=jpB6;
        Write file, "jpB6 " \Num:=v;
        v:=jpBack1;
        Write file, "jpBack1 " \Num:=v;
        v:=jpBack2;
        Write file, "jpBack2 " \Num:=v;
        v:=jpBack3;
        Write file, "jpBack3 " \Num:=v;
        v:=jpBack4;
        Write file, "jpBack4 " \Num:=v;
        v:=jpBack5;
        Write file, "jpBack5 " \Num:=v;
        v:=jpBack6;
        Write file, "jpBack6 " \Num:=v;
        v:=jpHigh;
        Write file, "jpHigh " \Num:=v;
        v:=jpLow;
        Write file, "jpLow " \Num:=v;
        v:=jpSum;
        Write file, "jpSum " \Num:=v;
        Close file;
    ENDPROC
ENDMODULE
